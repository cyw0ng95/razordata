// +build ignore

package main

import (
	"fmt"
	"os"
	"path/filepath"
	"strings"
	"text/template"
)

type opTemplate struct {
	Name       string
	Package    string
	HasChild   bool
	HasPred    bool
	HasOrderBy bool
	HasGroupBy bool
	IsJoin     bool
	IsScan     bool
	IsWindow   bool
	IsAgg      bool
	IsSetOp    bool
	MultiChild bool
}

var ops = []opTemplate{
	{Name: "SeqScan", Package: "EX", IsScan: true},
	{Name: "IndexScan", Package: "EX", IsScan: true},
	{Name: "Filter", Package: "EX", HasChild: true, HasPred: true},
	{Name: "Project", Package: "EX", HasChild: true},
	{Name: "Sort", Package: "EX", HasChild: true, HasOrderBy: true},
	{Name: "Limit", Package: "EX", HasChild: true},
	{Name: "NestedLoopJoin", Package: "EX", IsJoin: true, MultiChild: true},
	{Name: "HashJoin", Package: "EX", IsJoin: true, MultiChild: true},
	{Name: "HashAggregate", Package: "EX", HasChild: true, HasGroupBy: true, IsAgg: true},
	{Name: "Aggregate", Package: "EX", HasChild: true, HasGroupBy: true, IsAgg: true},
	{Name: "Distinct", Package: "EX", HasChild: true},
	{Name: "CompoundOp", Package: "EX", IsSetOp: true, MultiChild: true},
	{Name: "WindowOperator", Package: "EX", HasChild: true, IsWindow: true},
	{Name: "ExplainStmtOp", Package: "EX", HasChild: true},
	{Name: "CreateViewOperator", Package: "EX", HasChild: true},
}

const operatorTmpl = `// Code generated by gen.go; DO NOT EDIT.

package {{.Package}}

import (
	"context"
	"runtime"
	"sync"

	"github.com/cyw0ng95/razordata/internal/SQL/LX"
	"github.com/cyw0ng95/razordata/internal/SQL/PS"
)

// {{.Name}}BatchNext is a specialized batch-oriented execution function
// for {{.Name}}. It reads from the input batch, applies operator logic,
// and produces an output batch. Returns (nil, nil) at end of stream.
//
// This function is generated by the codegen framework (REQ000311).
// It replaces the interpreted Next() method with a compiled equivalent
// that operates on columnar batches for improved cache locality.
func {{.Name}}BatchNext(ctx context.Context, op any) func(ctx context.Context, batch *Batch, params []any) (*Batch, error) {
	return func(ctx context.Context, batch *Batch, params []any) (*Batch, error) {
		if batch == nil || batch.Size == 0 {
			return nil, nil
		}
		return process{{.Name}}Batch(ctx, op, batch, params)
	}
}

func process{{.Name}}Batch(ctx context.Context, op any, batch *Batch, params []any) (*Batch, error) {
	_ = ctx
	_ = params

	switch o := op.(type) {
	{{if .IsScan -}}
	case *SeqScan:
		return scanBatch(ctx, o, batch)
	case *IndexScan:
		return indexScanBatch(ctx, o, batch)
	{{end -}}
	{{if .HasPred -}}
	case *Filter:
		return filterBatch(ctx, o, batch)
	{{end -}}
	{{if eq .Name "Project" -}}
	case *Project:
		return projectBatch(ctx, o, batch)
	{{end -}}
	{{if .HasOrderBy -}}
	case *Sort:
		return sortBatch(ctx, o, batch)
	{{end -}}
	{{if eq .Name "Limit" -}}
	case *Limit:
		return limitBatch(ctx, o, batch)
	{{end -}}
	{{if .IsJoin -}}
	case *NestedLoopJoin:
		return nlJoinBatch(ctx, o, batch)
	case *HashJoin:
		return hjBatch(ctx, o, batch)
	{{end -}}
	{{if .IsAgg -}}
	case *HashAggregate:
		return hashAggBatch(ctx, o, batch)
	case *Aggregate:
		return aggBatch(ctx, o, batch)
	{{end -}}
	{{if eq .Name "Distinct" -}}
	case *Distinct:
		return distinctBatch(ctx, o, batch)
	{{end -}}
	{{if .IsWindow -}}
	case *WindowOperator:
		return windowBatch(ctx, o, batch)
	{{end -}}
	{{if eq .Name "ExplainStmtOp" -}}
	case *ExplainStmtOp:
		return explainBatch(ctx, o, batch)
	{{end -}}
	{{if eq .Name "CreateViewOperator" -}}
	case *CreateViewOperator:
		return createViewBatch(ctx, o, batch)
	{{end -}}
	}
	return batch, nil
}

{{if .IsScan}}
func scanBatch(ctx context.Context, op *SeqScan, batch *Batch) (*Batch, error) {
	_ = ctx
	out := GetBatch(len(batch.Cols))
	out.Size = 0
	for i, col := range batch.Cols {
		out.SetColumnName(i, col.Name)
	}
	out.SetColMap(batch.ColMap())
	for i := 0; i < batch.Size; i++ {
		for j, col := range batch.Cols {
			val := batch.Value(j, i)
			isNull := val == nil
			out.AppendRow(j, col.Type, val, isNull)
		}
		out.AdvanceSize()
	}
	return out, nil
}

func indexScanBatch(ctx context.Context, op *IndexScan, batch *Batch) (*Batch, error) {
	_ = ctx
	return batch, nil
}
{{end}}

