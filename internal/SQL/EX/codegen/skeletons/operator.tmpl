func filterBatch(ctx context.Context, op *Filter, batch *Batch) (*Batch, error) {
	sel := EvalBatch(op.Predicate(), batch, nil)
	if sel == nil {
		return batch, nil
	}
	if len(sel) == 0 {
		batch.Put()
		return nil, nil
	}
	out := GetBatch(len(batch.Cols))
	out.Size = 0
	for i, col := range batch.Cols {
		out.SetColumnName(i, col.Name)
	}
	out.SetColMap(batch.ColMap())
	for _, idx := range sel {
		for j, col := range batch.Cols {
			val := batch.Value(j, int(idx))
			isNull := val == nil
			out.AppendRow(j, col.Type, val, isNull)
		}
		out.AdvanceSize()
	}
	return out, nil
}
{{end}}

{{if eq .Name "Project"}}
func projectBatch(ctx context.Context, op *Project, batch *Batch) (*Batch, error) {
	_ = ctx
	return batch, nil
}
{{end}}

{{if .HasOrderBy}}
func sortBatch(ctx context.Context, op *Sort, batch *Batch) (*Batch, error) {
	_ = ctx
	return batch, nil
}
{{end}}

{{if eq .Name "Limit"}}
func limitBatch(ctx context.Context, op *Limit, batch *Batch) (*Batch, error) {
	_ = ctx
	out := GetBatch(len(batch.Cols))
	out.Size = 0
	limit := op.LimitValue()
	if limit <= 0 {
		batch.Put()
		return nil, nil
	}
	for i, col := range batch.Cols {
		out.SetColumnName(i, col.Name)
	}
	out.SetColMap(batch.ColMap())
	max := batch.Size
	if max > limit {
		max = limit
	}
	for i := 0; i < max; i++ {
		for j, col := range batch.Cols {
			val := batch.Value(j, i)
			isNull := val == nil
			out.AppendRow(j, col.Type, val, isNull)
		}
		out.AdvanceSize()
	}
	return out, nil
}
{{end}}

