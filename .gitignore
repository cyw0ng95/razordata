# Binaries
razordata
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
cover.out
coverage.txt

# Go fuzzing corpus — auto-generated by `go test -fuzz`. The
# failing inputs land here and should never be committed unless
# a maintainer explicitly opts in (commit the seed corpus, not
# the generated minimization cache).
testdata/fuzz/
**/testdata/fuzz/

# Dependency directories
vendor/

# Go workspace file
go.work

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Build artifacts
/dist/
/build/

# Debug
*.log

# Database files
*.razor/
data/
*.wal
*.db

# razordata specific data files
*.razor        # Database directory (e.g., testdb.razor/)
catalog/       # System catalog directory (created at runtime)
sst/           # SST files directory
*.sst          # Individual SST files
*.hint         # Buffer pool hint files
manifest       # LSM manifest files
meta.razor     # Meta page file
wal.razor      # WAL directory
wal.*          # WAL segment files (wal.000, wal.001, ...)

# Profiling
*.prof
*.pprof
cpu.pprof
mem.pprof

# Temp
tmp/
/tmp/

# AI Coding tools
.qwen
.monkeycode
.monkeycode-tmp-files
.mimocode
.omo

# Home directory artifacts
${HOME}/
.worktrees/
*.razor*
.engine
# Razordata engine-created databases accidentally rooted at the repo root
# when `razor` is invoked with a path that contains `?` or query-string-like args.
file:*
